{
  "name": "kakebo-mvp",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api": "npm run start:dev -w apps/api",
    "mobile": "npm run start -w apps/mobile",
    "build": "npm run build -w apps/api",
    "test": "npm run test -w apps/api",
    "typecheck": "npm run typecheck -w apps/mobile",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"docs/*.md\" README.md docker-compose.yml .github/workflows/ci.yml"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
